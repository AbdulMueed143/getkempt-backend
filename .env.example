# Copy to .env (git-ignored) or export in your shell / deployment task definition.

# HTTP port the API listens on (Dockerfile exposes 4000).
SERVER_PORT=4000

# MongoDB. Multi-document transactions (bookings, sales) require a replica set;
# `directConnection=true` is correct for a single-node local replica set.
MONGODB_URI=mongodb://localhost:27017/getkempt?directConnection=true
MONGODB_DATABASE=getkempt

# HMAC secret for signing JWTs. MUST be at least 32 characters; rotate per environment.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Optional. Server-side Google Places key used to enrich a store profile at signup.
GOOGLE_PLACES_API_KEY=
